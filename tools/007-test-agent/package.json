{
    "name": "007-test-agent",
    "version": "1.0.0",
    "description": "Universal testing tool for x402-enabled paywalled APIs",
    "type": "module",
    "scripts": {
        "start": "tsx src/index.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@scure/base": "1.2.6",
        "@solana/kit": "8.6.0",
        "@solana/signers": "8.6.0",
        "@x402/evm": "2.30.0",
        "@x402/fetch": "2.30.0",
        "@x402/svm": "2.30.0",
        "dotenv": "16.6.1",
        "viem": "2.57.17"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "@vitest/coverage-v8": "4.1.12",
        "@vitest/ui": "4.1.12",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vitest": "4.1.12",
        "@x402/core": "2.30.0"
    },
    "engines": {
        "node": ">=24.22.1 <25"
    },
    "packageManager": "npm@11.19.1"
}
