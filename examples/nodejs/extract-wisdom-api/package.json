{
    "name": "extract-wisdom-api",
    "version": "1.0.0",
    "description": "An Extract Wisdom API gated by x402 micropayments",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/presentation/http/server.ts",
        "build": "tsc",
        "start": "node dist/presentation/http/server.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
    },
    "keywords": [
        "x402",
        "micropayments",
        "api",
        "hono",
        "vertex-ai",
        "wisdom"
    ],
    "author": "Kobaru.io",
    "license": "Apache-2.0",
    "dependencies": {
        "@google/genai": "3.0.0",
        "@hono/node-server": "2.1.6",
        "@solana/kit": "8.6.0",
        "@x402/core": "2.30.0",
        "@x402/extensions": "2.30.0",
        "@x402/hono": "2.30.0",
        "@x402/svm": "2.30.0",
        "dotenv": "16.6.1",
        "hono": "4.13.17",
        "youtube-transcript-plus": "2.0.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vitest": "4.1.12"
    },
    "engines": {
        "node": ">=24.22.1 <25"
    },
    "packageManager": "npm@11.19.1"
