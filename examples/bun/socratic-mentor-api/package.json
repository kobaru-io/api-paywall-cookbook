{
    "name": "socratic-mentor-api",
    "version": "1.0.0",
    "description": "A Socratic AI Tutor monetized via x402 protocol using Vercel AI SDK (Bun)",
    "type": "module",
    "packageManager": "bun@1.4.4",
    "engines": {
        "bun": ">=1.4.4 <1.5"
    },
    "scripts": {
        "test": "bun test --isolate",
        "dev": "bun run --watch deploy/bun/server.ts",
        "start": "bun run deploy/bun/server.ts",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "x402",
        "micropayments",
        "ai",
        "hono",
        "vercel-ai-sdk",
        "socratic",
        "bun"
    ],
    "author": "Kobaru.io",
    "license": "Apache-2.0",
    "dependencies": {
        "@ai-sdk/google": "4.0.116",
        "@x402/core": "2.30.0",
        "@x402/evm": "2.30.0",
        "@x402/hono": "2.30.0",
        "ai": "7.0.168",
        "dotenv": "17.4.2",
        "hono": "4.13.17",
        "uuid": "13.0.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "typescript": "5.9.3"
    }
}
